# Copy to keystore.properties and fill in real values.
# Do NOT commit keystore.properties or the .jks/.keystore file.

storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=medira
keyPassword=YOUR_KEY_PASSWORD

# Create the keystore once from the android/ directory:
# keytool -genkeypair -v -keystore upload-keystore.jks -alias medira -keyalg RSA -keysize 2048 -validity 10000
