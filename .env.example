# Origin of the main REST API. No trailing slash.
# Current development backend is HTTP. For Android/Play you must provide HTTPS.
# Example production: https://api.your-domain.com
VITE_API_BASE_URL=http://185.222.163.113:7000

# Live chat WebSocket origin (ws:// or wss://). No trailing slash.
# Do not leave this as ws:// for a production Android build.
# Example production: wss://chat.your-domain.com
VITE_WS_URL=ws://185.222.163.113:4070

# Public website origin used in shareable invite / app-link URLs.
# Required for Android: Capacitor's https://localhost is NOT a valid share URL.
# Example: https://your-public-domain.com
VITE_PUBLIC_APP_URL=

# Food and exercise extract API. The default is loopback and is unreachable on a real device.
# Point this at a host the phone can reach (not 127.0.0.1).
VITE_EXTRACT_API_BASE_URL=http://127.0.0.1:8000

# Optional. Older diagnosis chat service used by MedicalChat.tsx (port 8000).
VITE_LEGACY_CHAT_API_BASE_URL=http://185.222.163.113:8000

# Android (Capacitor) notes:
# - Application ID is ai.medira.app (do not change after publishing).
# - Current HTTP APIs are allowed only for the known backend IP via
#   android/app/src/main/res/xml/network_security_config.xml.
# - Production Play builds should use HTTPS / WSS and then remove that cleartext config.
# - For a signed Play AAB, copy android/keystore.properties.example to
#   android/keystore.properties and create upload-keystore.jks locally.

